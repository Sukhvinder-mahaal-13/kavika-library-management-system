
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>KAVIKA - Contact</title>

<link rel="icon" href="images/kavika.jpeg">
    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- FONT AWESOME -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


    <%- include("../includes/navbar.ejs") %>


    <!-- ==================================================
         CONTACT
    ================================================== -->

    <main class="contact-page">


        <section class="contact-section">


            <!-- ==================================================
                 HEADING
            ================================================== -->

            <div class="contact-heading">


                <span class="contact-small-title">
                    CONNECT WITH KAVIKA
                </span>


                <h1>
                    Contact <span>KAVIKA</span>
                </h1>


                <p>
                    Have a question, suggestion or need help?
                    Get in touch with us and stay connected.
                </p>


            </div>



            <!-- ==================================================
                 CONTACT CARDS
            ================================================== -->

            <div class="contact-cards">


                <!-- ==================================================
                     PHONE
                ================================================== -->

                <a
                    href="tel:+918439151365"
                    class="contact-card"
                >

                    <div class="contact-icon">

                        <i class="fa-solid fa-phone"></i>

                    </div>


                    <div class="contact-card-content">

                        <span class="contact-label">
                            CALL US
                        </span>

                        <h2>
                            +91 9058644706
                        </h2>

                        <p>
                            Contact KAVIKA directly
                        </p>

                    </div>


                    <span class="contact-arrow">
                        ↗
                    </span>

                </a>



                <!-- ==================================================
                     INSTAGRAM
                ================================================== -->

                <a
                    href="https://www.instagram.com/kavika_library?igsi=MXVxbzE0ODR0eHFjcg=="
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-card"
                >

                    <div class="contact-icon">

                        <i class="fa-brands fa-instagram"></i>

                    </div>


                    <div class="contact-card-content">

                        <span class="contact-label">
                            FOLLOW US
                        </span>

                        <h2>
                            Instagram
                        </h2>

                        <p>
                            @kavika_library
                        </p>

                    </div>


                    <span class="contact-arrow">
                        ↗
                    </span>

                </a>



                <!-- ==================================================
                     FACEBOOK
                ================================================== -->

                <a
                    href="https://www.facebook.com/profile.php?id=61590649374327&sk=reels_tab"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-card"
                >

                    <div class="contact-icon">

                        <i class="fa-brands fa-facebook-f"></i>

                    </div>


                    <div class="contact-card-content">

                        <span class="contact-label">
                            CONNECT WITH US
                        </span>

                        <h2>
                            Facebook
                        </h2>

                        <p>
                            KAVIKA Library
                        </p>

                    </div>


                    <span class="contact-arrow">
                        ↗
                    </span>

                </a>



                <!-- ==================================================
                     YOUTUBE
                ================================================== -->

                <a
                    href="https://www.youtube.com/@Kavikalibrary"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-card"
                >

                    <div class="contact-icon">

                        <i class="fa-brands fa-youtube"></i>

                    </div>


                    <div class="contact-card-content">

                        <span class="contact-label">
                            WATCH US
                        </span>

                        <h2>
                            YouTube
                        </h2>

                        <p>
                            KAVIKA Library
                        </p>

                    </div>


                    <span class="contact-arrow">
                        ↗
                    </span>

                </a>


            </div>


        </section>


    </main>


</body>

</html>

