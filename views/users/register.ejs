
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>KAVIKA - Register</title>

    <link
        rel="icon"
        href="/images/kavika.jpeg"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <!-- ========================================
         NAVBAR
    ======================================== -->

    <%- include("../includes/navbar.ejs") %>


    <!-- ========================================
         REGISTER PAGE
    ======================================== -->

    <main class="auth-page">

        <div class="auth-container">

            <div class="auth-card">


                <!-- ========================================
                     HEADER
                ======================================== -->

                <div class="auth-header">

                    <p class="eyebrow">
                        JOIN KAVIKA
                    </p>

                    <h1>
                        Create Account
                    </h1>

                    <p>
                        Create your account and start
                        booking your study seat.
                    </p>

                </div>


                <!-- ========================================
                     REGISTER FORM
                ======================================== -->

                <form
                    action="/users/register"
                    method="POST"
                    class="auth-form"
                    id="registerForm"
                >


                    <!-- ========================================
                         NAME
                    ======================================== -->

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            autocomplete="name"
                            minlength="2"
                            maxlength="80"
                            required
                        >

                    </div>


                    <!-- ========================================
                         EMAIL
                    ======================================== -->

                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            maxlength="120"
                            required
                        >

                        <small>
                            An OTP will be sent to this email.
                        </small>

                    </div>


                    <!-- ========================================
                         MOBILE NUMBER
                    ======================================== -->

                    <div class="form-group">

                        <label for="phone">
                            Mobile Number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Enter 10 digit mobile number"
                            inputmode="numeric"
                            autocomplete="tel"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            minlength="10"
                            required
                        >

                        <small>
                            Your mobile number will be used for your KAVIKA account.
                        </small>

                    </div>


                    <!-- ========================================
                         PASSWORD
                    ======================================== -->

                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a password"
                            minlength="6"
                            maxlength="100"
                            autocomplete="new-password"
                            required
                        >

                    </div>


                    <!-- ========================================
                         VERIFICATION INFO
                    ======================================== -->

                    <div
                        style="
                            margin: 5px 0 18px;
                            padding: 14px 16px;
                            border: 1px solid var(--border);
                            border-radius: 12px;
                            background: var(--surface);
                            color: var(--muted);
                            font-size: 12px;
                            line-height: 1.6;
                        "
                    >

                        🔐 After creating your account,
                        you will need to verify your
                        <strong style="color: var(--text);">
                            email address
                        </strong>
                        using an OTP.

                    </div>


                    <!-- ========================================
                         SUBMIT BUTTON
                    ======================================== -->

                    <button
                        type="submit"
                        class="btn btn-primary auth-button"
                        id="registerButton"
                    >
                        Create Account →
                    </button>


                </form>


                <!-- ========================================
                     LOGIN
                ======================================== -->

                <div class="auth-footer">

                    <p>
                        Already have an account?
                    </p>

                    <a href="/users/login">
                        Login →
                    </a>

                </div>


            </div>

        </div>

    </main>


    <!-- ========================================
         FOOTER
    ======================================== -->

    <%- include("../includes/footer.ejs") %>


    <!-- ========================================
         REGISTER SCRIPT
    ======================================== -->

    <script>

        const phoneInput =
            document.getElementById("phone");

        const registerForm =
            document.getElementById("registerForm");

        const registerButton =
            document.getElementById("registerButton");


        // ========================================
        // PHONE - ONLY NUMBERS
        // ========================================

        phoneInput.addEventListener(
            "input",
            function () {

                this.value =
                    this.value
                        .replace(/\D/g, "")
                        .slice(0, 10);

            }
        );


        // ========================================
        // PREVENT DOUBLE SUBMIT
        // ========================================

        registerForm.addEventListener(
            "submit",
            function () {

                registerButton.disabled = true;

                registerButton.textContent =
                    "Sending OTP...";

            }
        );

    </script>


</body>

</html>

