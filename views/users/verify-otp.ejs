
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>KAVIKA - Verify Account</title>

    <link rel="icon" href="images/kavika.jpeg">

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        /* ========================================
           OTP PAGE
        ======================================== */

        .otp-page {

            min-height: calc(100vh - 70px);

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 60px 20px;

            position: relative;

            overflow: hidden;

        }


        /* ========================================
           BACKGROUND GLOW
        ======================================== */

        .otp-page::before {

            content: "";

            position: absolute;

            width: 500px;

            height: 500px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(255,255,255,.07),
                    transparent 68%
                );

            filter: blur(20px);

            pointer-events: none;

        }


        /* ========================================
           CONTAINER
        ======================================== */

        .otp-container {

            width: 100%;

            max-width: 520px;

            position: relative;

            z-index: 2;

        }


        /* ========================================
           CARD
        ======================================== */

        .otp-card {

            padding: 42px;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.055),
                    rgba(255,255,255,.025)
                );

            border: 1px solid var(--border);

            border-radius: 25px;

            box-shadow:
                0 30px 80px
                rgba(0,0,0,.45);

            backdrop-filter: blur(18px);

            animation:
                otpCardAppear
                .7s
                ease
                both;

        }


        /* ========================================
           ANIMATION
        ======================================== */

        @keyframes otpCardAppear {

            from {

                opacity: 0;

                transform:
                    translateY(25px)
                    scale(.97);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

            }

        }


        /* ========================================
           ICON
        ======================================== */

        .otp-icon {

            width: 70px;

            height: 70px;

            display: grid;

            place-items: center;

            margin-bottom: 25px;

            border-radius: 20px;

            background:
                var(--surface-light);

            border: 1px solid var(--border);

            font-size: 30px;

            box-shadow:
                0 12px 35px
                rgba(0,0,0,.25);

        }


        /* ========================================
           HEADER
        ======================================== */

        .otp-header h1 {

            font-size:
                clamp(
                    32px,
                    6vw,
                    46px
                );

            line-height: 1.05;

            margin-bottom: 14px;

        }


        .otp-header p {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.7;

            margin-bottom: 30px;

        }


        .otp-header .eyebrow {

            margin-bottom: 10px;

        }


        /* ========================================
           VERIFICATION INFO
        ======================================== */

        .verification-info {

            display: grid;

            gap: 10px;

            margin-bottom: 30px;

        }


        .verification-item {

            display: flex;

            align-items: center;

            gap: 12px;

            padding: 13px 15px;

            background:
                var(--surface);

            border: 1px solid var(--border);

            border-radius: 12px;

        }


        .verification-item-icon {

            width: 35px;

            height: 35px;

            display: grid;

            place-items: center;

            flex-shrink: 0;

            background:
                var(--surface-light);

            border-radius: 9px;

            font-size: 16px;

        }


        .verification-item-text {

            min-width: 0;

        }


        .verification-item-text span {

            display: block;

            color: var(--muted);

            font-size: 10px;

            font-weight: 800;

            letter-spacing: 1.5px;

            margin-bottom: 3px;

        }


        .verification-item-text strong {

            display: block;

            color: var(--text);

            font-size: 13px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

        }


        /* ========================================
           OTP FORM
        ======================================== */

        .otp-form {

            display: flex;

            flex-direction: column;

            gap: 22px;

        }


        .otp-group label {

            display: block;

            margin-bottom: 9px;

            color: var(--text);

            font-size: 13px;

            font-weight: 700;

        }


        /* ========================================
           OTP INPUT
        ======================================== */

        .otp-input {

            width: 100%;

            height: 58px;

            padding: 0 18px;

            border:
                1px solid var(--border);

            border-radius: 12px;

            outline: none;

            background:
                var(--surface-light);

            color: var(--text);

            font-size: 24px;

            font-weight: 800;

            letter-spacing: 8px;

            text-align: center;

            transition:
                border-color .25s ease,
                box-shadow .25s ease,
                transform .25s ease;

            box-sizing: border-box;

        }


        .otp-input::placeholder {

            color:
                rgba(255,255,255,.18);

            letter-spacing: 5px;

        }


        .otp-input:focus {

            border-color:
                var(--primary);

            box-shadow:
                0 0 0 4px
                rgba(255,255,255,.04);

            transform:
                translateY(-1px);

        }


        /* ========================================
           VERIFY BUTTON
        ======================================== */

        .verify-button {

            width: 100%;

            min-height: 54px;

            border: none;

            border-radius: 12px;

            background:
                var(--primary);

            color: white;

            font-size: 15px;

            font-weight: 800;

            cursor: pointer;

            transition:
                all .25s ease;

        }


        .verify-button:hover {

            background:
                var(--primary-dark);

            transform:
                translateY(-2px);

            box-shadow:
                0 12px 30px
                rgba(0,0,0,.3);

        }


        .verify-button:active {

            transform:
                translateY(0);

        }


        .verify-button:disabled {

            opacity: .7;

            cursor: not-allowed;

            transform: none;

        }


        /* ========================================
           RESEND
        ======================================== */

        .resend-area {

            margin-top: 25px;

            padding-top: 22px;

            border-top:
                1px solid var(--border);

            text-align: center;

        }


        .resend-area p {

            color: var(--muted);

            font-size: 13px;

            margin-bottom: 10px;

        }


        .resend-button {

            border: none;

            background: transparent;

            color: var(--primary);

            font-size: 13px;

            font-weight: 800;

            cursor: pointer;

            padding: 5px;

        }


        .resend-button:hover {

            text-decoration: underline;

        }


        .resend-button:disabled {

            color: var(--muted);

            cursor: not-allowed;

            text-decoration: none;

        }


        /* ========================================
           TIMER
        ======================================== */

        .otp-timer {

            color: var(--muted);

            font-size: 12px;

            margin-top: 8px;

        }


        .otp-timer strong {

            color: var(--text);

        }


        /* ========================================
           SECURITY NOTE
        ======================================== */

        .security-note {

            display: flex;

            align-items: flex-start;

            gap: 10px;

            margin-top: 25px;

            padding: 13px 15px;

            background:
                rgba(255,255,255,.025);

            border:
                1px solid var(--border);

            border-radius: 12px;

            color: var(--muted);

            font-size: 11px;

            line-height: 1.6;

        }


        .security-note span:first-child {

            flex-shrink: 0;

        }


        /* ========================================
           MOBILE
        ======================================== */

        @media (max-width: 600px) {

            .otp-page {

                padding:
                    35px 15px;

            }


            .otp-card {

                padding:
                    28px 20px;

                border-radius: 20px;

            }


            .otp-icon {

                width: 60px;

                height: 60px;

                font-size: 25px;

            }


            .otp-input {

                height: 54px;

                font-size: 21px;

                letter-spacing: 6px;

            }

        }

    </style>

</head>


<body>


<!-- ========================================
     NAVBAR
========================================= -->

<%- include("../includes/navbar.ejs") %>


<!-- ========================================
     OTP PAGE
========================================= -->

<main class="otp-page">

    <div class="otp-container">

        <div class="otp-card">


            <!-- ========================================
                 ICON
            ========================================= -->

            <div class="otp-icon">

                🔐

            </div>


            <!-- ========================================
                 HEADER
            ========================================= -->

            <div class="otp-header">

                <p class="eyebrow">

                    VERIFY YOUR ACCOUNT

                </p>


                <h1>

                    One last step.

                </h1>


                <p>

                    We sent a verification code to the
                    email address you entered during
                    registration.

                    Enter the code below to activate
                    your KAVIKA account.

                </p>

            </div>


            <!-- ========================================
                 USER CONTACT DETAILS
            ========================================= -->

            <div class="verification-info">


                <!-- ========================================
                     EMAIL
                ========================================= -->

                <div class="verification-item">

                    <div class="verification-item-icon">

                        ✉️

                    </div>


                    <div class="verification-item-text">

                        <span>

                            EMAIL OTP SENT TO

                        </span>


                        <strong>

                            <%= email %>

                        </strong>

                    </div>

                </div>


            </div>


            <!-- ========================================
                 OTP FORM
            ========================================= -->

            <form
                action="/users/verify-otp"
                method="POST"
                class="otp-form"
                id="otpForm"
            >


                <!-- ========================================
                     EMAIL OTP
                ========================================= -->

                <div class="otp-group">

                    <label for="emailOTP">

                        Email Verification Code

                    </label>


                    <input
                        type="text"
                        id="emailOTP"
                        name="emailOTP"
                        class="otp-input"
                        placeholder="000000"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        maxlength="6"
                        minlength="6"
                        pattern="[0-9]{6}"
                        required
                    >

                </div>


                <!-- ========================================
                     VERIFY BUTTON
                ========================================= -->

                <button
                    type="submit"
                    class="verify-button"
                    id="verifyButton"
                >

                    Verify Account →

                </button>

            </form>


            <!-- ========================================
                 RESEND OTP
            ========================================= -->

            <div class="resend-area">

                <p>

                    Didn't receive the code?

                </p>


                <form
                    action="/users/resend-otp"
                    method="POST"
                    id="resendForm"
                >

                    <button
                        type="submit"
                        class="resend-button"
                        id="resendButton"
                        disabled
                    >

                        Resend OTP

                    </button>

                </form>


                <div class="otp-timer">

                    You can resend in

                    <strong id="timer">

                        60

                    </strong>

                    seconds

                </div>

            </div>


            <!-- ========================================
                 SECURITY NOTE
            ========================================= -->

            <div class="security-note">

                <span>

                    🛡️

                </span>


                <span>

                    Never share your verification code
                    with anyone. KAVIKA will never ask
                    you for your OTP.

                </span>

            </div>


        </div>

    </div>

</main>


<!-- ========================================
     FOOTER
========================================= -->

<%- include("../includes/footer.ejs") %>


<!-- ========================================
     OTP SCRIPT
========================================= -->

<script>

    // ========================================
    // ELEMENTS
    // ========================================

    const otpForm =
        document.getElementById("otpForm");


    const resendForm =
        document.getElementById("resendForm");


    const emailOTP =
        document.getElementById("emailOTP");


    const verifyButton =
        document.getElementById("verifyButton");


    const resendButton =
        document.getElementById("resendButton");


    const timer =
        document.getElementById("timer");


    // ========================================
    // TIMER
    // ========================================

    let seconds = 60;


    const countdown =
        setInterval(() => {

            seconds--;

            timer.textContent =
                seconds;


            if (seconds <= 0) {

                clearInterval(countdown);

                resendButton.disabled =
                    false;

                timer.parentElement.textContent =
                    "You can resend the OTP now.";

            }

        }, 1000);


    // ========================================
    // ONLY NUMBERS
    // ========================================

    emailOTP.addEventListener(
        "input",
        function () {

            this.value =
                this.value
                    .replace(/\D/g, "")
                    .slice(0, 6);

        }
    );


    // ========================================
    // VERIFY BUTTON PROTECTION
    // ========================================

    otpForm.addEventListener(
        "submit",
        function () {

            verifyButton.disabled =
                true;

            verifyButton.textContent =
                "Verifying...";

        }
    );


    // ========================================
    // RESEND BUTTON
    // ========================================

    resendForm.addEventListener(
        "submit",
        function () {

            resendButton.disabled =
                true;

            resendButton.textContent =
                "Sending...";

        }
    );

</script>


</body>

</html>

