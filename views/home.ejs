<!DOCTYPE html>

<html lang="en">

<head>


<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>
<link rel="icon" href="images/kavika.jpeg">
<title>KAVIKA - Library</title>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
>

<link
    rel="stylesheet"
    href="/css/variables.css"
>

<link
    rel="stylesheet"
    href="/css/style.css"
